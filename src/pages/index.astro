---
import Layout from '../layouts/Layout.astro';
import { tools } from '../lib/catalog';
import { guides, guideHref } from '../lib/guides';
import { categories } from '../lib/categories';
const siteSchema = {'@context':'https://schema.org','@type':'WebSite',name:'FilePebble',url:'https://filepebble.com/',description:'Free browser-based tools to compare files, convert documents and process PDFs, images, JSON, CSV and Markdown.'};
---
<Layout title="Free File Comparison, PDF, Image & Data Tools | FilePebble" description="Compare CSV, JSON, text and images, merge or split PDF files, compress pictures and convert data in your browser. 19 free tools, no signup or uploads." schema={siteSchema}>
  <section class="hero wrap">
    <div class="hero-copy">
      <div class="eyebrow"><span class="tiny-square"></span> YOUR EVERYDAY FILE TOOLKIT</div>
      <h1>Small tools.<br />Better <span class="serif-accent">files.</span></h1>
      <p>Convert your notes. Compare your changes.<br class="desktop-br" /> Clean up your data. All in one quiet corner of the web.</p>
      <a href="#tools" class="primary-link">Find your tool <span>↗</span></a>
      <div class="hero-trust"><span>✓ No account needed</span><span>✓ Processed on your device</span></div>
    </div>
    <div class="hero-preview" aria-label="Example text comparison">
      <div class="preview-top"><span><i></i> A LITTLE CHANGE, CLEARLY SEEN</span><span>01 / {String(tools.length).padStart(2, '0')}</span></div>
      <div class="demo-title"><span class="demo-icon">±</span><div><strong>Text comparison</strong><small>Find what changed. Keep what matters.</small></div></div>
      <div class="demo-code"><div class="demo-label"><span>ORIGINAL → UPDATED</span><span>example.txt</span></div><div><b>01</b><code># A better way to work</code></div><div class="removed"><b>02</b><code>− Upload your files to a server.</code></div><div class="added"><b>02</b><code>+ Keep your files on your device.</code></div><div><b>03</b><code>Convert. Compare. Carry on.</code></div></div>
      <div class="demo-bottom"><span><i class="green-dot"></i> 1 line added · 1 line removed</span><a href="/tools/text-diff/">Try it yourself ↗</a></div>
      <div class="preview-note">Your files have places to go.<br /><em>Our servers aren't one of them.</em></div>
    </div>
  </section>
  <section class="workflow-section wrap" id="tool-groups" aria-labelledby="workflow-title">
    <div class="workflow-heading"><div><div class="eyebrow">QUICKLY FIND YOUR WORKFLOW</div><h2 id="workflow-title">Everything in its right place.</h2><p>Jump into a group, then pick the exact tool you need. No endless scrolling between converters.</p></div><a href="#tools">Browse all tools ↘</a></div>
    <div class="workflow-grid">
      {categories.map(group => <a class="workflow-card" href={`/categories/${group.slug}/`}>
        <span class="workflow-icon" aria-hidden="true">{group.icon}</span>
        <span class="workflow-text"><strong>{group.name}</strong><small>{group.lead}</small></span>
        <span class="workflow-count">{group.featured.length} tools</span><span class="workflow-arrow" aria-hidden="true">↗</span>
      </a>)}
    </div>
  </section>
  <section class="tool-section wrap" id="tools">
    <div class="section-top"><div><div class="eyebrow">LESS BUSYWORK. MORE DONE.</div><h2>What are we working on?</h2></div><label class="search-box"><span aria-hidden="true">⌕</span><input id="tool-search" type="search" placeholder="Find a tool…" aria-label="Search tools" /><kbd>/</kbd></label></div>
    <div class="category-row"><div class="filters" role="group" aria-label="Filter tools">{['All tools', 'Markdown', 'Compare', 'Data', 'Images', 'PDF'].map((category, i) => <button data-category={category} class={i === 0 ? 'active' : ''} aria-pressed={i === 0}>{category}{i === 0 && <span>{tools.length}</span>}</button>)}</div><span class="tool-count" aria-live="polite"><b id="result-count">{tools.length}</b> useful tools, zero fuss</span></div>
    <div class="tool-grid">{tools.map(tool => <a class="tool-card" href={`/tools/${tool.id}/`} data-category={tool.category} data-search={`${tool.name} ${tool.description} ${tool.category}`}><div class="card-top"><span class:list={['tool-icon', tool.category.toLowerCase()]}>{tool.symbol}</span><span class="card-arrow">↗</span></div><h3>{tool.name}</h3><p>{tool.description}</p><div class="card-bottom"><span>{tool.input}<b>→</b>{tool.output}</span><span class="local-tag"><i></i> LOCAL</span></div></a>)}</div>
    <p id="no-results" class="empty-search" hidden>No tools match that search. Try “Markdown”, “JSON”, or “compare”.</p>
  </section>
  <section class="featured-guide wrap" aria-labelledby="guide-csv">
    <div><div class="eyebrow">LEARN BY EXAMPLE</div><h2 id="guide-csv">Compare CSV exports without false differences</h2><p>Records can move between exports without actually changing. Follow a real before-and-after example to compare by ID, find edited cells, and recognise added and removed rows.</p></div>
    <a href="/guides/compare-csv-files-by-id/">Read the CSV comparison guide ↗</a>
  </section>
  <section class="home-guides wrap" aria-labelledby="home-guides-heading">
    <div class="home-guides-head"><div class="eyebrow">KNOW YOUR TOOLS</div><h2 id="home-guides-heading">Practical workflows, with examples</h2><p>Learn what each tool can actually do, the trade-offs to check and how to review the output before sharing.</p></div>
    <div class="home-guides-grid">
      {guides.slice(1, 4).map(guide => <article>
        <span class="eyebrow">{guide.category}</span>
        <h3><a href={guideHref(guide.slug)}>{guide.title} ↗</a></h3>
        <p>{guide.description}</p>
      </article>)}
    </div>
    <p><a class="all-guides-link" href="/guides/">Browse all {guides.length} practical guides ↗</a></p>
  </section>
  <section class="values-strip wrap"><div><span>01</span><h3>Your device does the work.</h3><p>File contents stay in your browser. No uploads required.</p></div><div><span>02</span><h3>Straight to the useful part.</h3><p>No registration, email gates, or waiting in a conversion queue.</p></div><div><span>03</span><h3>A growing little toolkit.</h3><p>Image tools and PDF essentials are here. <a href="/about/">See the roadmap ↗</a></p></div></section>
</Layout>
<script>
  const input = document.querySelector<HTMLInputElement>('#tool-search')!;
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-category]:is(button)');
  const cards = document.querySelectorAll<HTMLAnchorElement>('.tool-card');
  let category = 'All tools';
  function filter() {
    let count = 0;
    for (const card of cards) {
      const visible = (category === 'All tools' || card.dataset.category === category) && card.dataset.search!.toLowerCase().includes(input.value.trim().toLowerCase());
      card.hidden = !visible;
      if (visible) count++;
    }
    document.querySelector('#result-count')!.textContent = String(count);
    document.querySelector<HTMLElement>('#no-results')!.hidden = count > 0;
  }
  input.addEventListener('input', filter);
  buttons.forEach(button => button.addEventListener('click', () => {
    category = button.dataset.category!;
    buttons.forEach(b => { b.classList.toggle('active', b === button); b.setAttribute('aria-pressed', String(b === button)); });
    filter();
  }));
  document.addEventListener('keydown', event => {
    if (event.key === '/' && !(event.target instanceof HTMLInputElement || event.target instanceof HTMLTextAreaElement)) { event.preventDefault(); input.focus(); }
  });
</script>

<style>
  .featured-guide{display:flex;align-items:center;justify-content:space-between;gap:28px;padding-top:38px;padding-bottom:38px;border-top:1px solid var(--border)}
  .featured-guide h2{font-size:22px;font-weight:500;letter-spacing:-.5px;margin:11px 0}
  .featured-guide p{font-size:13px;line-height:1.8;color:var(--muted);max-width:610px;margin:0}
  .featured-guide>a{font-size:12px;color:var(--accent);text-decoration:underline;text-underline-offset:3px;flex-shrink:0}
  @media(max-width:650px){.featured-guide{display:block;padding-top:30px;padding-bottom:30px}.featured-guide>a{display:inline-block;margin-top:18px}}
</style>

<style>
  .home-guides{border-top:1px solid var(--border);padding-top:40px;padding-bottom:32px}
  .home-guides-head h2{font-weight:500;font-size:25px;letter-spacing:-.6px;margin:12px 0}
  .home-guides-head p,.home-guides-grid p{font-size:13px;line-height:1.8;color:var(--muted)}
  .home-guides-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin:24px 0}
  .home-guides-grid article{border:1px solid var(--border);padding:22px;border-radius:6px;background:#fffefa}
  .home-guides-grid h3{font-size:17px;font-weight:500;line-height:1.45;margin:13px 0}
  .home-guides-grid h3 a{color:var(--ink)}
  .home-guides-grid p{margin-bottom:0}
  .all-guides-link{font-size:13px;color:var(--accent);text-decoration:underline;text-underline-offset:3px}
  @media(max-width:650px){.home-guides-grid{grid-template-columns:1fr}.home-guides{padding-top:28px}}
</style>

<style>
  .workflow-section{padding-top:20px;padding-bottom:60px;scroll-margin-top:112px}
  .workflow-heading{display:flex;justify-content:space-between;align-items:end;gap:22px;margin-bottom:22px}
  .workflow-heading h2{font-size:clamp(28px,3.8vw,43px);font-weight:750;letter-spacing:-1.2px;margin:9px 0}
  .workflow-heading p{font-size:15px;line-height:1.75;color:var(--muted);margin:0}
  .workflow-heading>a{font-size:13px;color:var(--accent);font-weight:700;white-space:nowrap}
  .workflow-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:13px}
  .workflow-card{position:relative;display:flex;min-width:0;flex-direction:column;gap:14px;min-height:195px;border:1px solid var(--border);background:var(--surface);border-radius:20px;padding:18px;box-shadow:var(--soft-shadow);transition:transform .18s,border-color .18s,box-shadow .18s}
  .workflow-card:hover{transform:translateY(-4px);border-color:var(--accent);box-shadow:var(--shadow)}
  .workflow-icon{width:47px;height:47px;border-radius:14px;background:var(--wash);color:var(--accent);display:grid;place-items:center;font:22px Georgia,serif}
  .workflow-text{display:flex;flex-direction:column;gap:7px}
  .workflow-text strong{font-size:17px;line-height:1.3}
  .workflow-text small{font-size:13px;line-height:1.55;color:var(--muted)}
  .workflow-count{margin-top:auto;color:var(--muted);font-size:12px;font-weight:650}
  .workflow-arrow{position:absolute;top:19px;right:19px;color:var(--accent);font-size:20px}
  @media(max-width:1000px){.workflow-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
  @media(max-width:650px){.workflow-heading{display:block}.workflow-heading>a{display:inline-block;margin-top:15px}.workflow-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.workflow-card{padding:14px;min-height:178px}.workflow-text strong{font-size:15px}.workflow-text small{font-size:12px}}
</style>
