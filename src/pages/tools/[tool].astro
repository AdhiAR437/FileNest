---
import Layout from '../../layouts/Layout.astro';
import Workbench from '../../components/Workbench';
import ImageWorkbench from '../../components/ImageWorkbench';
import DataWorkbench from '../../components/DataWorkbench';
import ImageCompare from '../../components/ImageCompare';
import PdfWorkbench from '../../components/PdfWorkbench';
import { tools } from '../../lib/catalog';
import { toolGuides } from '../../lib/tool-guides';
import { toolInstructions } from '../../lib/tool-instructions';
import { toolSeo } from '../../lib/tool-seo';
export function getStaticPaths() { return tools.map(tool => ({ params: { tool: tool.id }, props: { tool } })); }
const { tool } = Astro.props;
const guide = toolGuides[tool.id];
const seo = toolSeo[tool.id];
---
<Layout title={seo.title} description={seo.description}>
  <section class="workbench-page wrap">
    <a href="/#tools" class="back-link">← All tools</a>
    <div class="workbench-heading"><div><div class="eyebrow">{tool.category.toUpperCase()} / PROCESSED LOCALLY</div><h1>{tool.name}</h1><p>{tool.description}</p></div><span class="tool-icon large-icon">{tool.symbol}</span></div>
    {tool.kind === 'data-tool' ? <DataWorkbench mode={tool.mode} client:load /> : tool.kind === 'image-compare' ? <ImageCompare client:load /> : tool.kind === 'pdf' ? <PdfWorkbench mode={tool.mode} client:load /> : tool.kind === 'image' ? <ImageWorkbench mode={tool.mode} client:load /> : <Workbench id={tool.id} client:load />}
    <div class="tool-explanation">
      <div>
        <h2>How to use {tool.name}</h2>
        <ol>{toolInstructions[tool.id].steps.map(step => <li>{step}</li>)}</ol>
      </div>
      <div>
        <h2>Before you begin</h2>
        <p>{toolInstructions[tool.id].note}</p>
        <p>See the worked example and tool-specific FAQs below for supported formats, limitations and troubleshooting. File contents are processed on your device, not uploaded to a FilePebble conversion server.</p>
      </div>
    </div>
    <div class="related-tools"><span class="eyebrow">KEEP GOING</span>{tools.filter(other => other.id !== tool.id && other.category === tool.category).map(other => <a href={`/tools/${other.id}`}>{other.name} ↗</a>)}</div>
    <section class="tool-guide" aria-labelledby="guide-heading">
      <div class="guide-intro">
        <div><div class="eyebrow">A PRACTICAL GUIDE</div><h2 id="guide-heading">When to use {tool.name}</h2><p>{guide.overview}</p></div>
        <aside class="guide-example"><h3>{guide.example.title}</h3><pre>{guide.example.text}</pre><p>{guide.example.note}</p></aside>
      </div>
      <h2>Frequently asked questions</h2>
      <div class="tool-faqs">{guide.faqs.map(faq => <details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</div>
      {tool.id === 'csv-diff' && <p class="guide-help"><strong>Step-by-step example:</strong> <a href="/guides/compare-csv-files-by-id/">Compare two CSV files by ID and identify added, removed and changed records</a>.</p>}
      <p class="guide-help">Still need a hand? <a href="/contact/">Contact the maintainer</a>.</p>
    </section>
  </section>
  <style>
    .tool-guide{border-top:1px solid var(--border);margin-top:40px;padding-top:40px}
    .guide-intro{display:grid;grid-template-columns:1fr 1fr;gap:40px;margin-bottom:36px}
    .tool-guide h2{font-size:23px;font-weight:500;letter-spacing:-.6px;line-height:1.4;margin:12px 0 18px}
    .tool-guide p{font-size:14px;line-height:1.8;color:#6d7066}
    .guide-example{min-width:0;border:1px solid var(--border);border-radius:6px;padding:24px;background:#fffefa}
    .guide-example h3{font-size:15px;font-weight:600;margin:0 0 18px}
    .guide-example pre{font:12px/1.8 'Courier New',monospace;white-space:pre-wrap;overflow-wrap:anywhere;margin:0;padding:16px;background:var(--paper);border-radius:4px}
    .guide-example p{font-size:12px;margin-bottom:0}
    .tool-faqs details{border-bottom:1px solid var(--border)}
    .tool-faqs summary{padding:18px 0;font-size:14px;line-height:1.6;cursor:pointer}
    .tool-faqs details p{margin:0 0 22px;max-width:850px}
    .guide-help a{text-decoration:underline;text-underline-offset:3px}
    @media(max-width:650px){.guide-intro{grid-template-columns:1fr;gap:22px}.tool-guide{padding-top:28px}.guide-example{padding:18px}.tool-guide h2{font-size:21px}}
  </style>
</Layout>
