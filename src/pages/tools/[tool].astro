---
import Layout from '../../layouts/Layout.astro';
import Workbench from '../../components/Workbench';
import ImageWorkbench from '../../components/ImageWorkbench';
import DataWorkbench from '../../components/DataWorkbench';
import ImageCompare from '../../components/ImageCompare';
import PdfWorkbench from '../../components/PdfWorkbench';
import { tools } from '../../lib/catalog';
export function getStaticPaths() { return tools.map(tool => ({ params: { tool: tool.id }, props: { tool } })); }
const { tool } = Astro.props;
---
<Layout title={`${tool.name} — Free local file tools | FileNest`} description={`${tool.description} Free to use, no signup, and processed locally in your browser.`}>
  <section class="workbench-page wrap">
    <a href="/#tools" class="back-link">← All tools</a>
    <div class="workbench-heading"><div><div class="eyebrow">{tool.category.toUpperCase()} / PROCESSED LOCALLY</div><h1>{tool.name}</h1><p>{tool.description}</p></div><span class="tool-icon large-icon">{tool.symbol}</span></div>
    {tool.kind === 'data-tool' ? <DataWorkbench mode={tool.mode} client:load /> : tool.kind === 'image-compare' ? <ImageCompare client:load /> : tool.kind === 'pdf' ? <PdfWorkbench mode={tool.mode} client:load /> : tool.kind === 'image' ? <ImageWorkbench mode={tool.mode} client:load /> : <Workbench id={tool.id} client:load />}
    <div class="tool-explanation"><div><h2>How it works</h2><ol><li>{tool.kind === 'image-compare' ? 'Choose two still JPG, PNG or WebP images with equal dimensions.' : tool.kind === 'pdf' ? 'Choose the PDF or image files for this tool.' : tool.kind === 'image' ? 'Choose a still JPG, PNG, or WebP image from your device.' : 'Paste your content or open a supported local file.'}</li><li>Choose your settings, then preview or process it.</li><li>{tool.kind === 'image-compare' ? 'Review the overlay or difference mask, then download the PNG difference image.' : tool.kind === 'pdf' ? 'Download your result; split pages and page images can be bundled as ZIP files.' : tool.kind === 'image' ? 'Review the result and download your image.' : 'Copy or download the result. Clear your work when finished.'}</li></ol></div><div><h2>A few useful details</h2><p>{tool.id === 'csv-diff' ? 'Compare CSV/TSV exports by data row position or by an exact, unique key column. Column order is ignored. Cell whitespace and case rules are optional. The report includes added and removed columns; XLSX is not supported.' : tool.id === 'json-formatter' ? 'Syntax validation accepts standard JSON. Formatting keeps original number spelling, string escapes, key order and duplicate keys. It does not validate against a schema.' : tool.id === 'markdown-to-docx' ? 'Word output includes headings, text emphasis, lists, tables, code and supported links. Raw HTML and images are omitted; image alt text is kept. The HTML preview illustrates Markdown content, not exact Word pagination.' : tool.kind === 'image-compare' ? 'Comparison uses correctly oriented images, composited on white. Pink pixels mark changes exceeding your chosen RGB threshold. Images are not automatically resized or aligned. Browser colour handling and lossy compression can affect pixel differences.' : tool.kind === 'pdf' ? 'Encrypted PDFs and interactive forms or signatures are not supported. Page operations do not preserve bookmarks and document-level features. PDF text extraction is not OCR; reading order may need cleanup.' : tool.kind === 'image' ? 'PNG and WebP can preserve transparency. JPG uses your chosen background. EXIF metadata is not retained; animated images, SVG, GIF, and HEIC are not supported. Compression may not reach your target or reduce an already optimised image. Output quality and colour can vary by browser.' : tool.kind === 'markdown' ? 'Remote images and embedded content are disabled. PDF export opens your browser’s print dialog; select Save as PDF where supported. Complex layouts and browser pagination can vary.' : tool.kind === 'json' ? 'Object key order is ignored. Arrays are compared by position. Changes use JSON Pointer paths; this is a structural comparison, not a semantic merge.' : tool.kind === 'data' ? 'CSV needs a header row. CSV → JSON keeps values as strings to preserve IDs and leading zeroes. JSON → CSV accepts an array of records, serialises nested values, and prefixes formula-like cells for safer spreadsheet opening.' : 'Compare line changes in a unified view. Whitespace and case rules are optional. Large or complex comparisons may be stopped to keep your browser responsive.'}</p><p>{tool.kind === 'image-compare' ? 'Up to 15 MB and 6 megapixels per image; difference downloads are limited to 20 MB.' : tool.id === 'markdown-to-docx' ? 'Word export accepts up to 250 KB of Markdown; output is limited to 10 MB. Tables allow up to 10 columns and 500 rows each.' : tool.id === 'csv-diff' ? 'Up to 1 MB, 10,000 data rows and 100 columns per CSV. The screen shows up to 200 changed rows; download the complete report as JSON.' : tool.id === 'json-formatter' ? 'Up to 1 MB of JSON and 200 nesting levels. Output is capped at 8 million characters, with a shortened on-screen preview for large results.' : tool.kind === 'pdf' ? 'Up to 20 MB per PDF, 40 MB combined and 100 pages total. Images to PDF accepts up to 20 images and 40 megapixels combined. Page image export is limited to 20 pages per job, 12 megapixels per page and 50 MB output.' : tool.kind === 'image' ? 'Images: up to 15 MB, 8,000 pixels per side and 12 megapixels total. One image per job; current browser required.' : 'Inputs are limited to 1 MB; text comparison is limited to 100,000 characters per side.'} File contents are not saved between visits.</p></div></div>
    <div class="related-tools"><span class="eyebrow">KEEP GOING</span>{tools.filter(other => other.id !== tool.id && other.category === tool.category).map(other => <a href={`/tools/${other.id}`}>{other.name} ↗</a>)}</div>
  </section>
</Layout>
