---
import '../styles/global.css';
import { tools } from '../lib/catalog';
import { categories } from '../lib/categories';
const menuGroups = categories.map(group => ({ ...group, items: tools.filter(tool => tool.category === group.name) }));
const { title = 'FilePebble — Small tools. Better files.', description = 'Free browser-based PDF, image, Markdown, comparison, and data tools. No account needed. File contents are processed on your device.', noindex = false, schema = null } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site!);
const verification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION?.trim();
const adsenseAccount = import.meta.env.PUBLIC_GOOGLE_ADSENSE_ACCOUNT?.trim() || 'ca-pub-2697619516906533';
if (verification && !/^[A-Za-z0-9_-]+$/.test(verification)) throw new Error('Use only the Search Console verification token, not a complete HTML tag.');
if (adsenseAccount && !/^ca-pub-\d{16}$/.test(adsenseAccount)) throw new Error('Use the AdSense account ID in ca-pub- followed by 16 digits format.');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (() => {
        try {
          const selected = localStorage.getItem('filepebble-theme');
          const preferred = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.dataset.theme = selected === 'dark' || selected === 'light' ? selected : preferred;
        } catch {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
    {noindex && <meta name="robots" content="noindex,follow" />}
    {verification && <meta name="google-site-verification" content={verification} />}
    {adsenseAccount && <meta name="google-adsense-account" content={adsenseAccount} />}
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FilePebble" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />}
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#f7f6f2" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header">
      <div class="site-header-inner wrap">
        <a href="/" class="brand" aria-label="FilePebble home"><span class="brand-mark">f.</span>file<span class="brand-md">pebble</span></a>
        <nav class="primary-nav" aria-label="Main navigation">
          <details class="nav-tool-menu" id="nav-tool-menu">
            <summary aria-label="Browse tools by category">
              <span class="nav-grid-symbol" aria-hidden="true">▦</span> Tools <span class="chevron" aria-hidden="true">⌄</span>
            </summary>
            <div class="tools-dropdown">
              <div class="dropdown-head"><div><strong>Find your next tool</strong><p>Choose a workflow or jump straight into a tool.</p></div><a class="dropdown-all" href="/#tools">View all 19 tools ↗</a></div>
              <div class="dropdown-grid">
                {menuGroups.map(group => <div class="dropdown-group">
                  <a class="dropdown-group-title" href={`/categories/${group.slug}/`}><span class="dropdown-group-icon" aria-hidden="true">{group.icon}</span>{group.name}<span class="group-count">{group.items.length}</span><span aria-hidden="true">↗</span></a>
                  <ul>{group.items.map(tool => <li><a href={`/tools/${tool.id}/`}>{tool.name}</a></li>)}</ul>
                </div>)}
              </div>
            </div>
          </details>
          <a href="/#tool-groups" class="nav-explore">Categories</a>
          <a href="/guides/">Guides</a>
          <a href="/about/" class="nav-about">About</a>
        </nav>
        <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode" title="Switch color theme">
          <svg class="theme-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.2 15.7A8.5 8.5 0 0 1 8.3 3.8 8.5 8.5 0 1 0 20.2 15.7Z"/></svg>
          <svg class="theme-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <span class="theme-toggle-label">Theme</span>
        </button>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer wrap">
      <div><a href="/" class="brand small-brand"><span class="brand-mark">f.</span>file<span class="brand-md">pebble</span></a><p>A little less friction. A better file.</p></div>
      <div class="footer-links"><a href="/about/">About & roadmap</a><a href="/guides/">Guides & tutorials</a><a href="/contact/">Contact</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/licenses/">Open-source notices</a><span>Built for your browser ↗</span></div>
    </footer>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const button = document.getElementById('theme-toggle');
        const menu = document.getElementById('nav-tool-menu');
        const updateLabel = () => {
          if (!button) return;
          const dark = root.dataset.theme === 'dark';
          button.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
          button.setAttribute('title', dark ? 'Switch to light mode' : 'Switch to dark mode');
        };
        updateLabel();
        button?.addEventListener('click', () => {
          const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('filepebble-theme', next); } catch {}
          updateLabel();
        });
        document.addEventListener('keydown', event => {
          if (event.key === 'Escape' && menu?.open) {
            menu.open = false;
            menu.querySelector('summary')?.focus();
          }
        });
        document.addEventListener('pointerdown', event => {
          if (menu?.open && !menu.contains(event.target)) menu.open = false;
        });
      })();
    </script>
  </body>
</html>
