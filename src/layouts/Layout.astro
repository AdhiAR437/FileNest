---
import '../styles/global.css';
const { title = 'FilePebble — Small tools. Better files.', description = 'Free browser-based PDF, image, Markdown, comparison, and data tools. No account needed. File contents are processed on your device.', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site!);
const verification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION?.trim();
const adsenseAccount = import.meta.env.PUBLIC_GOOGLE_ADSENSE_ACCOUNT?.trim() || 'ca-pub-2697619516906533';
if (verification && !/^[A-Za-z0-9_-]+$/.test(verification)) throw new Error('Use only the Search Console verification token, not a complete HTML tag.');
if (adsenseAccount && !/^ca-pub-\d{16}$/.test(adsenseAccount)) throw new Error('Use the AdSense account ID in ca-pub- followed by 16 digits format.');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    {verification && <meta name="google-site-verification" content={verification} />}
    {adsenseAccount && <meta name="google-adsense-account" content={adsenseAccount} />}
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FilePebble" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#f7f6f2" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header wrap">
      <a href="/" class="brand" aria-label="FilePebble home"><span class="brand-mark">f.</span>file<span class="brand-md">pebble</span></a>
      <nav aria-label="Main navigation"><a href="/#tools">All tools</a><a href="/guides/">Guides</a><a href="/about/">Our approach</a><span class="header-tag"><i></i> Free. No signup.</span></nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer wrap">
      <div><a href="/" class="brand small-brand"><span class="brand-mark">f.</span>file<span class="brand-md">pebble</span></a><p>A little less friction. A better file.</p></div>
      <div class="footer-links"><a href="/about/">About & roadmap</a><a href="/guides/">Guides & tutorials</a><a href="/contact/">Contact</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/licenses/">Open-source notices</a><span>Built for your browser ↗</span></div>
    </footer>
  </body>
</html>
